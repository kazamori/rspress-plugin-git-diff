    {
      "dot": "cyan",
      "title": "Resolve",
      "items": [
        "A commit hash must be one that changed the page; a tag can name any point",
        "A single revision compares the page before and after that commit"
      ]
    },
    {
      "dot": "emerald",
      "title": "Map and mark",
      "items": [
        "The page shows the latest version, so older changes are followed to it",
        "Lines rewritten after the change are marked as changed again later",
        "Marking waits until blocks carrying this page's route are rendered"
      ]
    },
    {
      "dot": "orange",
      "title": "Navigate",
      "items": [
        "Touching deletions and additions count as one stop",
        "Moving scrolls the stop to the center and outlines it",
        "The source diff panel opens from the bar"
      ]
