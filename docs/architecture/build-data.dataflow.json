      "dot": "cyan",
      "title": "Read once",
      "items": [
        "One git log over the docs root replaces a git log --follow per page",
        "One cat-file process reads every blob the build needs"
      ]
    },
    {
      "dot": "emerald",
      "title": "Left out of the lists",
      "items": [
